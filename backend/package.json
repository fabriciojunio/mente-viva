{
  "name": "mente-viva-backend",
  "version": "1.0.0",
  "description": "API REST para o app Mente Viva: prevenção cognitiva baseada em evidências",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:int": "node --test tests/integration/**/*.test.js",
    "test:sec": "node --test tests/security/**/*.test.js",
    "db:seed": "node src/infrastructure/database/seed.js",
    "db:reset": "node src/infrastructure/database/reset.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
